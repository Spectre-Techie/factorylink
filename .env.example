# Core runtime
NODE_ENV=development
PORT=4000
APP_ENV=development

# Application
NEXT_PUBLIC_APP_NAME=FactoryLink
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/factorylink

# Africa's Talking (server-side only)
AT_ENVIRONMENT=sandbox
AT_USERNAME=your-africas-talking-username
AT_API_KEY=replace-with-server-only-key
AT_BASE_URL=https://api.africastalking.com
AT_SENDER_ID=FactoryLink

# Security and auth
JWT_SECRET=change-me
SESSION_SECRET=change-me
WEBHOOK_SECRET=change-me

# Operational
LOG_LEVEL=info
