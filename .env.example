# Runtime
NODE_ENV=development
PORT=4000

# Frontend and API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Supabase (use values from the Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Africa's Talking (server-side only)
AT_ENVIRONMENT=sandbox
AT_USERNAME=your-africas-talking-username
AT_API_KEY=your-server-only-api-key
AT_BASE_URL=https://api.africastalking.com
AT_SENDER_ID=FactoryLink
